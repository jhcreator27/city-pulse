# Segreti delle Edge Functions (Supabase → Edge Functions → Secrets, oppure:
#   supabase secrets set --env-file .env)
# NON mettere questi valori in web/config.js: restano solo sul server.
SITE_URL=https://citypulse.it
STRIPE_SECRET_KEY=sk_live_...           # in prova usa sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
BOOKING_FEE_CENTS=150                   # diritto di prevendita per ordine (€1,50)
VAPID_PUBLIC_KEY=BK...
VAPID_PRIVATE_KEY=...
VAPID_SUBJECT=mailto:info@citypulse.it
# SUPABASE_URL e SUPABASE_SERVICE_ROLE_KEY sono già disponibili automaticamente
RESEND_API_KEY=re_...                  # email di conferma con QR (resend.com)
EMAIL_FROM=City Pulse <biglietti@citypulse.it>
